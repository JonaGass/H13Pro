ACTION!="add", GOTO="aw"
KERNEL=="sd[a-z]",           SUBSYSTEM=="block", ENV{NPARTS}=="0",    RUN+="/usr/bin/udev_handler add udisk /dev/%k"
KERNEL=="sd[a-z][0-9]",      SUBSYSTEM=="block", ENV{PARTN}=="[1-9]", RUN+="/usr/bin/udev_handler add udisk /dev/%k"
#KERNEL=="mmcblk[0-9]",       SUBSYSTEM=="block", RUN+="/usr/bin/udev_handler add sd /dev/%k"
#KERNEL=="mmcblk[0-9]p[0-9]", SUBSYSTEM=="block", ENV{PARTN}=="[1-9]", RUN+="/usr/bin/udev_handler add sd /dev/%k"
LABEL="aw"

ACTION!="remove", GOTO="aw"
#KERNEL=="sd[a-z]",     SUBSYSTEM=="block", RUN+="/usr/bin/udev_handler remove udisk"
#KERNEL=="mmcblk[0-9]p[0-9]", SUBSYSTEM=="block", RUN+="/usr/bin/udev_handler remove sd"
LABEL="aw"

ACTION!="change", GOTO="aw"
KERNEL=="hdmi", SUBSYSTEM=="extcon", ATTR{state}=="HDMI=1", RUN+="/usr/bin/udev_handler add hdmi"
KERNEL=="hdmi", SUBSYSTEM=="extcon", ATTR{state}=="HDMI=0", RUN+="/usr/bin/udev_handler remove hdmi"
KERNEL=="cvbs", SUBSYSTEM=="extcon", ATTR{state}=="1", RUN+="/usr/bin/udev_handler add cvbs"
KERNEL=="cvbs", SUBSYSTEM=="extcon", ATTR{state}=="0", RUN+="/usr/bin/udev_handler remove cvbs"
KERNEL=="tp9950", SUBSYSTEM=="csi", ENV{SENSOR_RAVAL}=="0x4", RUN+="/usr/bin/udev_handler remove tp9950"
KERNEL=="tp9950", SUBSYSTEM=="csi", ENV{SENSOR_RAVAL}=="0x3", RUN+="/usr/bin/udev_handler add tp9950"
KERNEL=="tp9950", SUBSYSTEM=="csi", ENV{SENSOR_BACK}=="0x3", RUN+="/usr/bin/udev_handler add backcarvideo"
KERNEL=="tp9950", SUBSYSTEM=="csi", ENV{SENSOR_BACK}=="0x4", RUN+="/usr/bin/udev_handler remove backcarvideo"

KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{SENSOR_RAVAL}=="0x0", RUN+="/usr/bin/udev_handler remove back_camera"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{SENSOR_RAVAL}=="0x1", RUN+="/usr/bin/udev_handler add back_camera"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{SENSOR_REVERSE}=="0x1", RUN+="/usr/bin/udev_handler add backcar_video"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{SENSOR_REVERSE}=="0x0", RUN+="/usr/bin/udev_handler remove backcar_video"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{VBUS_REVERSE}=="0x0", RUN+="/usr/bin/udev_handler remove det_vbus"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{VBUS_REVERSE}=="0x1", RUN+="/usr/bin/udev_handler add det_vbus"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{KEY_RAVAL}=="0x0", RUN+="/usr/bin/udev_handler remove power_key"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{KEY_RAVAL}=="0x1", RUN+="/usr/bin/udev_handler add power_key"

KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{SHORT_KEY}=="0x1", RUN+="/usr/bin/udev_handler add short_key"
KERNEL=="misc", SUBSYSTEM=="misc_gpio", ENV{LONG_KEY}=="0x1", RUN+="/usr/bin/udev_handler add long_key"

LABEL="aw"

ACTION!="change", GOTO="gadget"
KERNEL=="android0", SUBSYSTEM=="android_usb", ATTR{state}=="CONFIGURED", RUN+="/usr/bin/udev_handler add usb2host"
KERNEL=="android0", SUBSYSTEM=="android_usb", ATTR{state}=="DISCONNECTED", RUN+="/usr/bin/udev_handler remove usb2host"
LABEL="gadget"
